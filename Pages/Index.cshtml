@page
@model VersiyonTakip.Pages.IndexModel

@{
    ViewData["Title"] = "Versiyon Takip";
}

<style>
    body {
        background-color: #121212;
        color: #f1f1f1;
    }

    h1, h2, h3, p, th, td, label {
        color: #f1f1f1;
    }

    .card {
        background-color: #242424;
        border: 1px solid #383838;
        border-radius: 12px;
    }

    .card-body {
        padding: 25px;
    }

    .table {
        background-color: #242424;
        color: #f1f1f1;
        border-color: #444;
    }

        .table th {
            background-color: #303030;
            color: white;
        }

        .table td {
            background-color: #242424;
            color: #e0e0e0;
        }

    .table-striped > tbody > tr:nth-of-type(odd) > * {
        background-color: #2c2c2c;
        color: #e0e0e0;
    }

    a {
        color: #9b8cff;
    }

        a:hover {
            color: #c0b6ff;
        }

    .btn-primary {
        background-color: #6c55d9;
        border-color: #6c55d9;
    }

        .btn-primary:hover {
            background-color: #5540b5;
            border-color: #5540b5;
        }

    .btn-outline-secondary {
        color: #ddd;
        border-color: #777;
    }

        .btn-outline-secondary:hover {
            background-color: #444;
            color: white;
        }

    .alert-danger {
        background-color: #471f25;
        color: #ffb8c0;
        border-color: #71313b;
    }

    .alert-info {
        background-color: #1d3445;
        color: #b8dcf5;
        border-color: #31536d;
    }
</style>

<h1>Versiyon Takip</h1>

<p>GitHub'da yayımlanan uygulama sürümleri</p>

@if (Model.LatestRelease is not null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2>En Son Sürüm</h2>

            <h3>@Model.LatestRelease.TagName</h3>

            <p>@Model.LatestRelease.Name</p>

            <p>
                @(string.IsNullOrWhiteSpace(Model.LatestRelease.Body)
                    ? "Açıklama girilmemiş."
                    : Model.LatestRelease.Body)
            </p>

            <a class="btn btn-primary"
               href="@Model.LatestRelease.ZipballUrl"
               onclick="return confirmDownload();">
                Kaynak Kodunu İndir
            </a>

            <a class="btn btn-outline-secondary"
               href="@Model.LatestRelease.HtmlUrl"
               target="_blank"
               rel="noopener noreferrer">
                GitHub Release
            </a>
        </div>
    </div>
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}
else if (Model.Releases.Count == 0)
{
    <div class="alert alert-info">
        Henüz yayımlanmış bir sürüm bulunamadı.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Versiyon</th>
                <th>Başlık</th>
                <th>Yayın Tarihi</th>
                <th>Açıklama</th>
                <th>Bağlantı</th>
                <th>İndir</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var release in Model.Releases)
            {
                <tr>
                    <td>@release.TagName</td>
                    <td>@release.Name</td>
                    <td>
                        @(release.PublishedAt?
                            .ToLocalTime()
                            .ToString("dd.MM.yyyy HH:mm") ?? "-")
                    </td>
                    <td>
                        <div style="white-space: pre-line">
                            @release.Body
                        </div>
                    </td>
                    <td>
                        <a href="@release.HtmlUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            GitHub'da aç
                        </a>
                    </td>
                    <td>
                        <a href="@release.ZipballUrl"
                           onclick="return confirmDownload();">
                            Kaynak kodu indir (.zip)
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <script>
        function confirmDownload() {
            return confirm("Bu sürümü indirmek istediğinizden emin misiniz?");
        }
    </script>
}
